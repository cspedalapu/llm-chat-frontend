# Copy to .env (next to docker-compose.yml) and fill in what you use. Never commit .env.
# Every value is optional; leaving one empty keeps that feature off.

# Where browsers reach the app. OAuth redirect URLs are built from it:
#   <CHAT_PUBLIC_URL>/api/connectors/oauth/callback
CHAT_PUBLIC_URL=http://localhost:5173

# Host ports (defaults 8000 / 5173 / 8080) if they clash with other projects.
# BACKEND_PORT=8001
# FRONTEND_PORT=5174
# FRONTEND_PROD_PORT=8082

# Google Drive sign-in for Research. Create an OAuth client (Web application) in
# Google Cloud Console, enable the Drive API, add the redirect URL above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OneDrive / SharePoint sign-in. Register an app in Microsoft Entra ID with
# delegated Files.Read.All and Sites.Read.All, and the redirect URL above.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Academic search etiquette and higher limits (both optional).
RESEARCH_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Let research open pages on private/LAN addresses (e.g. a SearXNG on your network).
# Leave empty in production: it disables the SSRF protection.
RESEARCH_ALLOW_PRIVATE_NETWORK=
